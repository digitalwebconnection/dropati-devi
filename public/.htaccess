# ----------------------------------------------------------------------
# Dropati Devi Foundation - Production .htaccess configuration
# ----------------------------------------------------------------------

# 1. CHARSET & ENCODING
AddDefaultCharset UTF-8

# 2. PREVENT DIRECTORY BROWSING
Options -Indexes -MultiViews

# 3. REWRITE ENGINE & SPA ROUTING
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite real existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all other routes to index.html (SPA History API)
  RewriteRule ^ index.html [L]
</IfModule>

# 4. GZIP / DEFLATE COMPRESSION
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# 5. BROWSER CACHING (EXPIRES HEADERS)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML - Short/Zero cache so updates are delivered immediately
  ExpiresByType text/html "access plus 0 seconds"

  # CSS and JavaScript (versioned with hash by Vite)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Web Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # Images and Icons
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Data manifests
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
</IfModule>

# 6. CACHE-CONTROL HEADERS
<IfModule mod_headers.c>
  # 1 year caching for Vite hashed immutable assets
  <FilesMatch "\.(css|js|woff2|woff|ttf|otf|webp|jpg|jpeg|png|svg)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Prevent caching of index.html so users always get fresh releases
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # 7. SECURITY HEADERS
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# 8. BLOCK ACCESS TO SENSITIVE FILES
<FilesMatch "(^\.|\.env|\.git|\.lock$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Allow public webmanifest and sitemap
<FilesMatch "(site\.webmanifest|manifest\.json|sitemap\.xml|robots\.txt)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>

# 9. CUSTOM ERROR HANDLING
ErrorDocument 404 /index.html
